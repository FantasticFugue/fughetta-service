[Unit]
Description=Fughetta workspace %i task scheduler
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=@FUGHETTA_SERVICE_USER@
Group=@FUGHETTA_SERVICE_USER@
StateDirectory=fughetta-service/%i
WorkingDirectory=/var/lib/fughetta-service/%i
ExecStart=@CMAKE_INSTALL_FULL_BINDIR@/fughetta-service --instance %i @CMAKE_INSTALL_FULL_SYSCONFDIR@/fughetta-service/%i/config.json
Restart=on-failure
TimeoutStartSec=120
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal
KillMode=mixed

[Install]
WantedBy=multi-user.target
