<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>dev.fughetta.service</string>
  <key>ProgramArguments</key><array>
    <string>@CMAKE_INSTALL_FULL_BINDIR@/fughetta-service</string>
    <string>@CMAKE_INSTALL_FULL_SYSCONFDIR@/fughetta-service/config.json</string>
  </array>
  <key>UserName</key><string>fughetta</string>
  <key>WorkingDirectory</key><string>/var/lib/fughetta-service</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ExitTimeOut</key><integer>15</integer>
</dict></plist>
