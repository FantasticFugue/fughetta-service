@PACKAGE_INIT@

# fughetta-service's modules as sources: this config registers the same targets the
# repository builds (async, coroutine, native, http, content, configuration, ...)
# and the consumer's build compiles them, since module BMIs are not portable.
include(CMakeFindDependencyMacro)
find_dependency(xclang CONFIG)

if(NOT TARGET content)
  include("${CMAKE_CURRENT_LIST_DIR}/dependencies.cmake")
  set(FUGHETTA_SOURCE "${PACKAGE_PREFIX_DIR}/share/fughetta-service/src")
  set(FUGHETTA_PACKAGE ON)
  include("${CMAKE_CURRENT_LIST_DIR}/modules.cmake")
endif()

check_required_components(fughetta-service)
