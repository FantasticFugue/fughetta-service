<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DisableImplicitFSharpCoreReference>true</DisableImplicitFSharpCoreReference>
    <NuGetAudit>false</NuGetAudit>
    <AssemblyName>fughetta-fsharp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host provides ILanguageAdapter and FSharp.Core at run time. -->
    <ProjectReference Include="../host/fughetta-clr.fsproj" Private="false" />
    <Reference Include="FSharp.Core" HintPath="$(MSBuildToolsPath)/FSharp/FSharp.Core.dll" Private="false" />
    <Reference Include="FSharp.Compiler.Service" HintPath="$(MSBuildToolsPath)/FSharp/FSharp.Compiler.Service.dll" />
    <Compile Include="Model.fs" />
    <Compile Include="Reads.fs" />
    <Compile Include="Types.fs" />
    <Compile Include="Records.fs" />
    <Compile Include="Adapter.fs" />
  </ItemGroup>
</Project>
