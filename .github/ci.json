{
  "toolchain": {
    "llvm": "23.1.5",
    "ninja": "1.13.2",
    "python": "3.x",
    "java": {"distribution": "temurin"},
    "gradle": "current"
  },
  "compile_jobs": 2,
  "build_attempts": 6,
  "download_retries": 3,
  "rate_limit_wait_seconds": 30,
  "profiles": {
    "check": {"preset": "debug", "timeout": 360},
    "package": {"preset": "release", "timeout": 150, "targets": "fughetta-service llvm-provider clr-providers jvm-providers"}
  },
  "runners": [
    {"id": "linux-x64", "label": "ubuntu-24.04"},
    {"id": "macos-arm64", "label": "macos-15", "check": {"configure": "-DCLANG_SANITIZER=", "retain_test_log": true}},
    {"id": "windows-x64", "label": "windows-2025", "check": {"configure": "-DCLANG_SANITIZER="}}
  ]
}
