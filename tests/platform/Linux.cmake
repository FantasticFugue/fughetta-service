# Linux runs the process, runner and fsync suites, the managed budget, and the
# scenarios that load the managed hosts.
include("${CMAKE_CURRENT_LIST_DIR}/posix.cmake")
add_suite(platform.spawn platform/spawn.cpp)
add_suite(model.runner model/runner.cpp)
add_suite(platform.fsync platform/fsync.cpp)
add_suite(system.managed-budget system/processes.cpp SERVICE TIMEOUT 90)
set(TEST_MANAGED_HOSTS ON)
add_suite(host.api host/api.cpp host_executor)
add_suite(host.oci host/oci.cpp host_executor)
add_executable(host-workload host/workload.cpp)
target_link_libraries(host-workload PRIVATE yyjson::yyjson)
target_compile_options(host-workload PRIVATE -fno-sanitize=all)
target_link_options(host-workload PRIVATE -fno-sanitize=all)
add_suite(host.containerd host/containerd.cpp SERVICE TIMEOUT 240 host_executor)
target_compile_definitions(host.containerd-test PRIVATE HOST_WORKLOAD="$<TARGET_FILE:host-workload>")
add_dependencies(host.containerd-test host-workload)
set_tests_properties(host.containerd PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE)
add_test(NAME host.volume COMMAND host.containerd-test volume)
set_tests_properties(host.volume PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 120)

add_test(NAME host.process COMMAND host.containerd-test process)
set_tests_properties(host.process PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 120)
add_test(NAME host.userspace COMMAND host.containerd-test userspace)
set_tests_properties(host.userspace PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 120)

add_test(NAME host.microvm COMMAND host.containerd-test microvm)
set_tests_properties(host.microvm PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 300)
add_test(NAME host.nspawn COMMAND host.containerd-test nspawn)
set_tests_properties(host.nspawn PROPERTIES SKIP_RETURN_CODE 77 RUN_SERIAL TRUE TIMEOUT 120)
